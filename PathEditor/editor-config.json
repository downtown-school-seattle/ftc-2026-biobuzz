{
  "game": "DECODE 2025-2026",
  "field": {
    "width": 144,
    "height": 144,
    "gridSize": 24,
    "image": "fields/Biobuzz-Juice.png"
  },
  "robot": {
    "width": 18,
    "length": 18
  },
  "motion": {
    "driveSpeed": 40,
    "turnSpeed": 180
  },
  "export": {
    "indent": "        ",
    "run": "run({commands});",
    "drive": "driveCmd({degrees}, {inches})",
    "turn": "turnCmd({degrees})",
    "driveSign": 1,
    "turnSign": 1
  },
  "actions": [
    {
      "id": "rotate",
      "label": "Rotate to heading",
      "kind": "turn",
      "unit": "deg",
      "default": 90
    },
    {
      "id": "rotateDrive",
      "label": "Rotate while driving",
      "kind": "turnDrive",
      "unit": "deg",
      "default": 90
    },
    {
      "id": "shooter",
      "label": "Set shooter RPM",
      "kind": "command",
      "unit": "rpm",
      "default": 4000,
      "template": "motorCmd(shooterMotor, {value})"
    },
    {
      "id": "intake",
      "label": "Set intake RPM",
      "kind": "command",
      "unit": "rpm",
      "default": 1000,
      "template": "motorCmd(intakeMotor, {value})"
    },
    {
      "id": "wait",
      "label": "Wait",
      "kind": "wait",
      "unit": "s",
      "default": 1,
      "template": "waitCmd({value})"
    }
  ]
}
